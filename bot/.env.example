# Token del bot Telegram (ottenuto da @BotFather)
TELEGRAM_BOT_TOKEN=

# API Key Anthropic
ANTHROPIC_API_KEY=

# Telegram user_id numerico di MarcoMan (ottenibile scrivendo /start a @userinfobot)
TELEGRAM_ALLOWED_USER_ID=

# Porta su cui Railway ascolta (Railway la imposta automaticamente, non toccare)
PORT=3000

# URL pubblico del servizio Railway (es: https://kirk-bot.up.railway.app)
# Necessario per registrare il webhook Telegram al primo avvio
RAILWAY_PUBLIC_URL=
